# Salin file ini menjadi .env lalu isi nilainya.

# Telegram — token dari @BotFather
BOT_TOKEN=123456789:AAA...your-bot-token-here

# Database (async PostgreSQL driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/campus_assistant

# AI provider (fitur Tanya AI)
# OpenRouter memakai API yang kompatibel dengan OpenAI.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Opsional, dipakai sebagai metadata aplikasi di OpenRouter.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Campus Assistant Bot

# Alternatif jika ingin memakai OpenAI langsung:
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Logging
LOG_LEVEL=INFO

# Scheduler pengingat
REMINDER_CHECK_INTERVAL_MINUTES=5
REMINDER_BEFORE_MINUTES=60
REMINDER_SEND_RETRIES=2
REMINDER_RETRY_DELAY_SECONDS=2

# Penyimpanan dokumen
DOCUMENT_STORAGE_PATH=storage/documents
DOCUMENT_MAX_FILE_SIZE_MB=20
PDF_SUMMARY_STORAGE_PATH=storage/pdf_summaries
PDF_SUMMARY_RETENTION_HOURS=1
PDF_SUMMARY_CHUNK_PAGES=50
